# Data (raw data can be large / sensitive coordinates — keep out of git history)
data/raw_data.csv
data/*.csv
!data/.gitkeep
!data/README.md

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Outputs that are regenerated by scripts
outputs/figures/*.png
outputs/models/*.pkl
outputs/models/*.joblib
!outputs/figures/.gitkeep
!outputs/models/.gitkeep

# Streamlit
.streamlit/secrets.toml

# Environment
.env
!data/clean_data.csv
